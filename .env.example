# Copiar a .env y rellenar. El .env real NO va a git.

# Neon Postgres — pooled (runtime) y unpooled (migraciones)
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=require"

# Redis (VM GCE — worker sports-sync + rate limiting de la API)
REDIS_URL="redis://<ip-vm-gce>:6379"

SPORTRADAR_API_KEY=

# Secret que Vercel Cron manda como Authorization: Bearer — protege
# /api/internal/cron/tick, que también dispara GitHub Actions cada hora.
CRON_SECRET=

# API
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
