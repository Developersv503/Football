// Schema pensado para ~10k conexiones/día: toda consulta de listado va
// paginada sobre una columna indexada, y los contadores que se leen en
// cada request (predictionsCount, stats de perfil) están denormalizados
// en vez de recalcularse con COUNT/aggregate en caliente.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer) — la usa la app en runtime, muchas conexiones cortas.
  url       = env("DATABASE_URL")
  // Unpooled — solo para `prisma migrate`/`db push` (pgbouncer no soporta
  // el protocolo de migraciones). Neon te da ambas URLs en el dashboard.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Catálogo deportivo ───────────────────────────

model Sport {
  id           String        @id @default(cuid())
  key          String        @unique // "soccer", "hockey", "tennis", ... (estable, viene de Sportradar)
  name         String
  competitions Competition[]
  events       Event[]

  @@map("sports")
}

model Competition {
  id            String   @id @default(cuid())
  sportradarId  String   @unique // sr:competition:XXX — idempotencia en el upsert del worker
  sportId       String
  sport         Sport    @relation(fields: [sportId], references: [id])
  name          String
  country       String?
  events        Event[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sportId])
  @@map("competitions")
}

enum EventStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

model Event {
  id              String      @id @default(cuid())
  sportradarId    String      @unique
  sportId         String
  sport           Sport       @relation(fields: [sportId], references: [id])
  competitionId   String
  competition     Competition @relation(fields: [competitionId], references: [id])
  homeTeam        String
  awayTeam        String
  startTime       DateTime
  status          EventStatus @default(SCHEDULED)
  homeScore       Int?
  awayScore       Int?
  // Denormalizado: se incrementa atómicamente al crear una Prediction.
  // Evita un COUNT(*) sobre predictions en cada tarjeta de evento listada.
  predictionsCount Int        @default(0)

  predictions Prediction[]
  odds        Odds[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Listado principal: filtrar por deporte + rango de fecha, ordenado por hora.
  @@index([sportId, startTime])
  // Filtrar por liga + fecha (tab de competición específica).
  @@index([competitionId, startTime])
  // Filtrar por estado (ej. "en vivo") + fecha.
  @@index([status, startTime])
  @@map("events")
}

// Solo lectura — referencia informativa, no se opera contra esto.
model Odds {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookmaker  String
  market     String   @default("1x2")
  homeOdds   Decimal? @db.Decimal(6, 2)
  drawOdds   Decimal? @db.Decimal(6, 2)
  awayOdds   Decimal? @db.Decimal(6, 2)
  updatedAt  DateTime @updatedAt

  @@unique([eventId, bookmaker, market])
  @@index([eventId])
  @@map("odds")
}

// ───────────────────────────── Usuarios / perfil ──────────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())

  profile     PredictorProfile?
  predictions Prediction[]
  entries     TournamentEntry[]
  auditLogs   AuditLog[]

  @@map("users")
}

// 1:1 con User. Se actualiza en el job de liquidación (sports-sync), NUNCA
// se recalcula con un aggregate sobre Prediction en el request del perfil.
model PredictorProfile {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalPredictions     Int      @default(0)
  correctPredictions   Int      @default(0)
  accuracyBasisPoints  Int      @default(0) // % acierto * 100, entero — evita floats en index/orden
  rankScore            Int      @default(0)
  currentStreak        Int      @default(0)
  updatedAt            DateTime @updatedAt

  // Leaderboard global de pronosticadores, paginado por score.
  @@index([rankScore(sort: Desc)])
  @@map("predictor_profiles")
}

// ───────────────────────────────ámbito de negocio: pronósticos ────────────

enum PredictionOutcome {
  HOME
  DRAW
  AWAY
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  VOID
}

model Prediction {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  eventId   String
  event     Event              @relation(fields: [eventId], references: [id])
  outcome   PredictionOutcome
  status    PredictionStatus   @default(PENDING)
  createdAt DateTime           @default(now())
  settledAt DateTime?

  // Un pronóstico por usuario por evento.
  @@unique([userId, eventId])
  // Historial del usuario, paginado por fecha.
  @@index([userId, createdAt(sort: Desc)])
  // El worker de liquidación busca PENDING por evento cuando el partido termina.
  @@index([eventId, status])
  @@map("predictions")
}

// ────────────────────────────────── Torneos ───────────────────────────────

enum TournamentType {
  DAILY
  MONTHLY
  CUSTOM
}

enum TournamentStatus {
  UPCOMING
  ACTIVE
  CLOSED
  SETTLED
}

model Tournament {
  id             String           @id @default(cuid())
  name           String
  type           TournamentType
  status         TournamentStatus @default(UPCOMING)
  startAt        DateTime
  endAt          DateTime
  entryFeeCents  Int              @default(0)
  prizePoolCents Int              @default(0)
  createdAt      DateTime         @default(now())

  entries TournamentEntry[]

  // Listado de torneos activos/próximos, ordenado por inicio.
  @@index([status, startAt])
  @@map("tournaments")
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  score        Int        @default(0)
  rank         Int?
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
  // Leaderboard del torneo, paginado por score.
  @@index([tournamentId, score(sort: Desc)])
  @@map("tournament_entries")
}

// ────────────────────────────────── Auditoría ─────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String?
  ip        String
  createdAt DateTime    @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}
